@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            @* The cart indicator is its own Interactive Server island so its count updates live on
               every otherwise-static page; it shares the circuit's scoped CartState with the catalog. *@
            <CartIndicator @rendermode="InteractiveServer" />
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
