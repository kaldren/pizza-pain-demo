{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Base URL of the Pizza Pain HTTP API (src/pizza.api). Committed dev default — override per
  // environment. Matches the api project's https launch profile (see its launchSettings.json).
  "PizzaApi": {
    "BaseUrl": "https://localhost:7266"
  },
  // Microsoft Entra ID (Azure AD) sign-in. Non-secret scaffolding only.
  // TenantId, ClientId and ClientSecret are NOT committed — they are sourced
  // from user-secrets locally (see README / spec login-entra-id).
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "",
    "ClientId": "",
    "CallbackPath": "/signin-oidc"
  }
}
