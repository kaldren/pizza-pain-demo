@page "/login"
@layout LoginLayout

<PageTitle>Sign in · Pizza Pain</PageTitle>

<section class="login-card" aria-labelledby="login-heading">
    <div class="brand">
        <span class="brand-mark" aria-hidden="true">🍕</span>
        <span class="brand-name">Pizza Pain</span>
    </div>

    <h1 id="login-heading" class="login-title">Welcome back</h1>
    <p class="login-subtitle">Sign in with your work or school account to start ordering.</p>

    <a class="ms-signin" href="@LoginUrl">
        <svg class="ms-logo" width="20" height="20" viewBox="0 0 21 21" aria-hidden="true" focusable="false">
            <rect x="1" y="1" width="9" height="9" fill="#F25022" />
            <rect x="11" y="1" width="9" height="9" fill="#7FBA00" />
            <rect x="1" y="11" width="9" height="9" fill="#00A4EF" />
            <rect x="11" y="11" width="9" height="9" fill="#FFB900" />
        </svg>
        <span>Sign in with Microsoft</span>
    </a>

    <p class="login-foot">
        You'll be redirected to Microsoft Entra ID to authenticate securely.
    </p>
</section>

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    // Hand the requested destination to the challenge endpoint so the user lands back where they
    // started after signing in.
    private string LoginUrl =>
        string.IsNullOrWhiteSpace(ReturnUrl)
            ? "authentication/login"
            : $"authentication/login?returnUrl={Uri.EscapeDataString(ReturnUrl)}";
}
