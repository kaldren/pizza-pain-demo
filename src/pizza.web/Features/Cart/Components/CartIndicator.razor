@using pizza.web.Features.Cart.Services
@implements IDisposable
@inject CartState Cart

@* Top-right app-shell widget (next to the user info) showing how many items are in the cart and
   linking to the cart page. At zero items the numeric badge is hidden but the icon stays, so empty
   reads differently from populated (spec add-to-cart §4.3–§4.5). Clicking/activating it navigates to
   /cart (spec cart-page §1). The count is conveyed to assistive tech via aria-label, not by color
   alone. Subscribes to CartState.Changed so it re-renders live when the cart changes. *@
<a class="cart-indicator" href="/cart" aria-label="@AriaLabel">
    <span class="cart-icon" aria-hidden="true">🛒</span>
    @if (Cart.ItemCount > 0)
    {
        <span class="cart-badge">@Cart.ItemCount</span>
    }
</a>

@code {
    private string AriaLabel => Cart.ItemCount switch
    {
        0 => "View cart: empty",
        1 => "View cart: 1 item",
        var n => $"View cart: {n} items"
    };

    protected override void OnInitialized() => Cart.Changed += OnCartChanged;

    // CartState raises Changed off the UI thread context; marshal back onto the renderer before
    // re-rendering.
    private void OnCartChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Cart.Changed -= OnCartChanged;
}
