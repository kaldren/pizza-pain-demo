{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Microsoft Entra ID (Azure AD) JWT bearer validation. Non-secret scaffolding only.
  // TenantId and ClientId (the API's app registration / token audience) are NOT committed —
  // they are sourced from user-secrets locally (see spec secure-api-entra-id).
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "",
    "ClientId": ""
  }
}
